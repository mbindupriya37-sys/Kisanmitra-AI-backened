server.port=8080
spring.application.name=KisanMitra-AI

# MySQL Database Configuration
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://127.0.0.1:3306/kisanmitra?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Spring Data JPA Configuration
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Flyway
spring.flyway.enabled=false
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.baseline-description=Existing baseline schema (13 tables)

# JWT Authentication
kisanmitra.app.jwtSecret=${KISANMITRA_APP_JWTSECRET:${JWT_SECRET:}}
kisanmitra.app.jwtExpirationMs=${KISANMITRA_APP_JWTEXPIRATIONMS:86400000}

# Crop Knowledge Seeder
kisanmitra.crop-knowledge.seed-enabled=true

# Weather API
kisanmitra.weather.base-url=https://api.open-meteo.com/v1
kisanmitra.weather.geocoding-url=https://geocoding-api.open-meteo.com/v1
kisanmitra.weather.api-key=${WEATHER_API_KEY:}

# Market Intelligence
kisanmitra.market.base-url=https://api.data.gov.in/resource/9ef07375-19f2-4571-9599-7e2800a83e3e
kisanmitra.market.api-key=${DATA_GOV_IN_API_KEY:}
kisanmitra.market.connect-timeout-ms=5000
kisanmitra.market.read-timeout-ms=5000

# Actuator
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=when_authorized
management.endpoint.health.probes.enabled=true
management.info.env.enabled=false

# Springdoc OpenAPI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.tryItOutEnabled=true

# Temporary startup diagnostics
logging.level.org.springframework=INFO
logging.level.org.springframework.orm.jpa=DEBUG
logging.level.org.hibernate=INFO
logging.level.com.zaxxer.hikari=INFO